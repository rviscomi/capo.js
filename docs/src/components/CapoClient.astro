---
import { Icon } from "@astrojs/starlight/components";
import { Tabs, TabItem } from "@astrojs/starlight/components";
import VirtualConsole from "./VirtualConsole.astro";
---

<script>
  import { run } from "../../../src/web/capo.js";
  import { fetchGist, exchangeCodeForToken, createGist } from "../lib/gist.js";
  import { highlightHTML } from "../lib/CapoWidgetElement.js";
  import type { VirtualConsole } from "../lib/VirtualConsole.js";

  // GitHub OAuth settings - loaded from Astro environment files (.env.development / .env.production)
  const GITHUB_CLIENT_ID = import.meta.env.PUBLIC_GITHUB_CLIENT_ID;

  const WORKER_AUTH_ENDPOINT = "https://capo.rviscomi.workers.dev/auth";

  document.addEventListener("DOMContentLoaded", init);

  let markup: HTMLTextAreaElement | null = null;
  let input: HTMLFormElement | null = null;
  let virtualConsole: VirtualConsole | null = null;
  let url: HTMLInputElement | null = null;
  let shareBtn: HTMLButtonElement | null = null;
  let highlightPre: HTMLElement | null = null;
  let codeEl: HTMLElement | null = null;
  let lastFetchedUrl = "";
  let lastFetchedUrlHtml = "";
  let activeTabName = "HTML";
  let activeFetchController: AbortController | null = null;
  let activeFetchPromise: Promise<string> | null = null;
  let activeFetchUrl: string | null = null;

  function syncHighlight() {
    if (!markup || !codeEl) return;
    codeEl.innerHTML = highlightHTML(markup.value) + "\n";
    syncScroll();
  }

  function syncScroll() {
    if (!markup || !highlightPre) return;
    highlightPre.scrollTop = markup.scrollTop;
    highlightPre.scrollLeft = markup.scrollLeft;
  }

  async function init() {
    const root = document.querySelector("#capo-client");
    if (!root) return;

    input = root.querySelector("#input");
    virtualConsole = root.querySelector("virtual-console");
    markup = root.querySelector("#markup");
    highlightPre = root.querySelector(".capo-widget-highlight");
    codeEl = root.querySelector(".capo-widget-code");
    url = root.querySelector("#url");
    shareBtn = root.querySelector("#share");

    if (markup) {
      markup.addEventListener("input", syncHighlight);
      markup.addEventListener("scroll", syncScroll);
      syncHighlight();
    }

    await handleOAuthCallback();
    const loadedGist = await initGist();
    if (!loadedGist) {
      initUrl();
    }

    if (input) {
      input.addEventListener("submit", (e) => {
        handleSubmit();
        e.preventDefault();
        return false;
      });
    }

    if (shareBtn) {
      shareBtn.addEventListener("click", () => handleShare());
    }
  }

  function findTab(name: string): HTMLElement | null {
    const root = document.querySelector("#capo-client");
    if (!root) return null;
    const target = name.trim().toUpperCase();
    const tabs = Array.from(root.querySelectorAll<HTMLElement>("[role=tab]"));
    return tabs.find((tab) => (tab.textContent || "").trim().toUpperCase().includes(target)) || null;
  }

  function switchTab(name: string) {
    activeTabName = name;
    const tab = findTab(name);
    if (tab) {
      tab.click();
    }
  }

  async function initUrl() {
    const thisUrl = new URL(location.href);
    const urlParam = thisUrl.searchParams.get("url");
    if (!urlParam || !url) {
      return;
    }
    url.value = urlParam;
    switchTab("URL");
    try {
      await handleSubmit();
    } catch (e) {
      console.error("Capo error", e);
    }
  }

  async function initGist() {
    const thisUrl = new URL(location.href);
    const gistParam = thisUrl.searchParams.get("gist");
    if (!gistParam) {
      return false;
    }

    if (!/^[a-f0-9]+$/i.test(gistParam.trim())) {
      showNotification(`Invalid Gist ID "${gistParam}"`, true);
      return false;
    }

    switchTab("HTML");

    try {
      if (markup) {
        markup.value = "Loading Gist...";
        syncHighlight();
      }
      const content = await fetchGist(gistParam);
      if (markup) {
        markup.value = content;
        syncHighlight();
      }
      await handleSubmit();
      return true;
    } catch (e: any) {
      console.error("Capo error loading gist", e);
      if (markup) {
        markup.value = `Error loading Gist: ${e.message}`;
        syncHighlight();
      }
      return false;
    }
  }

  let notificationTimeout: ReturnType<typeof setTimeout>;
  function showNotification(message: string, isError = false) {
    const notificationEl = document.querySelector("#notification");
    if (!notificationEl) return;

    clearTimeout(notificationTimeout);
    notificationEl.textContent = message;
    notificationEl.classList.remove("hidden");
    if (isError) {
      notificationEl.classList.add("error");
    } else {
      notificationEl.classList.remove("error");
    }

    notificationTimeout = setTimeout(() => {
      notificationEl.classList.add("hidden");
    }, 4500);
  }

  async function handleOAuthCallback() {
    const thisUrl = new URL(location.href);
    const code = thisUrl.searchParams.get("code");
    if (!code) {
      return;
    }

    try {
      const redirectUri = window.location.origin + window.location.pathname;
      const token = await exchangeCodeForToken(code, redirectUri, GITHUB_CLIENT_ID, WORKER_AUTH_ENDPOINT);
      localStorage.setItem("capo_github_token", token);
      showNotification("GitHub authentication successful!");

      const pendingShare = sessionStorage.getItem("capo_pending_share");
      if (pendingShare) {
        sessionStorage.removeItem("capo_pending_share");
        try {
          const {
            tab,
            url: savedUrl,
            markup: savedMarkup,
            lastFetchedUrl: savedLastUrl,
            lastFetchedUrlHtml: savedLastHtml,
          } = JSON.parse(pendingShare);

          if (savedLastUrl && savedLastHtml) {
            lastFetchedUrl = savedLastUrl;
            lastFetchedUrlHtml = savedLastHtml;
          }

          if (tab === "URL" && savedUrl && url) {
            url.value = savedUrl;
            switchTab("URL");
          } else if (tab === "HTML" && savedMarkup && markup) {
            markup.value = savedMarkup;
            switchTab("HTML");
          }
          setTimeout(() => handleShare(tab), 10);
        } catch (err) {
          console.error("Failed to process pending share", err);
        }
      }
    } catch (e: any) {
      console.error("OAuth token exchange failed", e);
      showNotification(`GitHub authentication failed: ${e.message}`, true);
    } finally {
      thisUrl.searchParams.delete("code");
      history.replaceState(null, "", thisUrl);
    }
  }

  function getSelectedTab(): "URL" | "HTML" {
    const urlPanel = url?.closest('[role="tabpanel"]');
    if (urlPanel && !urlPanel.hasAttribute("hidden")) {
      return "URL";
    }
    return "HTML";
  }

  async function handleShare(targetTab?: string) {
    if (!shareBtn) return;
    const selectedTab = targetTab || getSelectedTab();
    let htmlContent: string | undefined;

    const originalContent = shareBtn.innerHTML;

    if (selectedTab === "URL") {
      if (!url || !url.value || !url.validity.valid) {
        showNotification(`Invalid URL "${url?.value || ""}"`, true);
        return;
      }
      try {
        if (lastFetchedUrl !== url.value || !lastFetchedUrlHtml) {
          shareBtn.disabled = true;
          shareBtn.textContent = "Fetching HTML...";
        }
        htmlContent = await getStaticHTML(url.value);
      } catch (e: any) {
        showNotification(`Failed to fetch URL HTML: ${e.message}`, true);
        shareBtn.disabled = false;
        shareBtn.innerHTML = originalContent;
        return;
      }
    } else {
      htmlContent = markup?.value;
    }

    if (!htmlContent || htmlContent.trim() === "") {
      showNotification("Cannot save empty HTML content.", true);
      return;
    }

    const token = localStorage.getItem("capo_github_token");
    if (!token) {
      try {
        sessionStorage.setItem(
          "capo_pending_share",
          JSON.stringify({
            tab: selectedTab,
            url: selectedTab === "URL" ? url?.value : null,
            markup: selectedTab === "HTML" ? markup?.value : null,
            lastFetchedUrl: lastFetchedUrl,
            lastFetchedUrlHtml: lastFetchedUrlHtml,
          }),
        );
      } catch (e) {
        console.warn("Failed to save pending share state", e);
      }

      // Redirect to GitHub OAuth flow
      const redirectUri = window.location.origin + window.location.pathname;
      const authUrl = `https://github.com/login/oauth/authorize?client_id=${GITHUB_CLIENT_ID}&scope=gist&redirect_uri=${encodeURIComponent(redirectUri)}`;
      window.location.href = authUrl;
      return;
    }

    try {
      shareBtn.disabled = true;
      shareBtn.textContent = "Saving Gist...";
      const gistId = await createGist(htmlContent, token);

      if (markup) {
        markup.value = htmlContent;
      }

      const shareUrl = new URL(location.href);
      if (selectedTab === "URL" && url?.value) {
        shareUrl.searchParams.set("url", url.value);
      } else {
        shareUrl.searchParams.delete("url");
      }
      shareUrl.searchParams.set("gist", gistId);

      history.replaceState(null, "", shareUrl);

      await navigator.clipboard.writeText(shareUrl.toString()).catch(() => {});

      shareBtn.innerHTML = "✓ Link copied!";
      shareBtn.classList.add("success");
      showNotification("Gist created and permalink copied to clipboard!");

      setTimeout(() => {
        if (shareBtn) {
          shareBtn.classList.remove("success");
          shareBtn.innerHTML = originalContent;
        }
      }, 3500);
    } catch (e: any) {
      if (e.name === "AbortError") return;
      if (e.message === "Unauthorized") {
        localStorage.removeItem("capo_github_token");
        // Retry share to trigger redirect
        handleShare(selectedTab);
        return;
      }
      console.error("Failed to create Gist", e);
      showNotification(`Failed to save Gist: ${e.message}`, true);
      shareBtn.innerHTML = originalContent;
    } finally {
      shareBtn.disabled = false;
    }
  }

  function setUrl(urlParam: string) {
    const thisUrl = new URL(location.href);
    thisUrl.searchParams.delete("gist");
    thisUrl.searchParams.set("url", urlParam);
    history.replaceState(null, "", thisUrl);
  }

  async function handleSubmit() {
    try {
      const html = await getHtml();
      if (!virtualConsole) return;
      virtualConsole.clear();
      const selectedTab = getSelectedTab();
      const pageOrigin = selectedTab === "URL" && url?.value ? new URL(url.value).origin : null;
      run(html, virtualConsole, { pageOrigin });
    } catch (e: any) {
      if (e.name === "AbortError") return;
      console.error("Capo error", e);
      showNotification(`Error: ${e.message}`, true);
    }
  }

  async function getHtml(): Promise<string> {
    let html: string | undefined;
    const selectedTab = getSelectedTab();

    if (selectedTab === "URL") {
      if (!url || !url.value || !url.validity.valid) {
        throw new Error(`Invalid URL "${url?.value || ""}"`);
      }
      if (url.value != url.getAttribute("placeholder")) {
        setUrl(url.value);
      }
      html = await getStaticHTML(url.value);
    } else {
      html = markup?.value;
    }

    if (!html) {
      throw new Error("Unable to run. Invalid HTML.");
    }

    return html;
  }

  async function getStaticHTML(targetUrl: string): Promise<string> {
    if (lastFetchedUrl === targetUrl && lastFetchedUrlHtml) {
      return lastFetchedUrlHtml;
    }

    if (activeFetchUrl === targetUrl && activeFetchPromise) {
      return activeFetchPromise;
    }

    if (activeFetchController) {
      activeFetchController.abort();
    }

    activeFetchController = new AbortController();
    activeFetchUrl = targetUrl;

    activeFetchPromise = (async () => {
      const proxy = new URL("https://capo.rviscomi.workers.dev/");
      proxy.searchParams.set("url", targetUrl);

      const response = await fetch(proxy, { signal: activeFetchController?.signal });

      if (response.status == 502) {
        throw new Error(`502 Gateway Error. The URL ${targetUrl} cannot be fetched. (Possibly too many redirects)`);
      } else if (response.status == 404) {
        throw new Error("Unable to fetch that URL. The page might not exist.");
      } else if (!response.ok) {
        throw new Error(
          "Unknown error fetching the URL. Please file an issue: https://github.com/rviscomi/capo.js/issues/",
        );
      }

      const text = await response.text();

      lastFetchedUrl = targetUrl;
      lastFetchedUrlHtml = text;

      return text;
    } )();

    try {
      return await activeFetchPromise;
    } finally {
      if (activeFetchUrl === targetUrl) {
        activeFetchPromise = null;
        activeFetchController = null;
        activeFetchUrl = null;
      }
    }
  }
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .capo-widget-code-container {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    min-height: 150px;
    max-height: 400px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background-color: var(--sl-color-black);
    overflow: hidden;
  }

  :root[data-theme='light'] .capo-widget-code-container {
    background-color: var(--sl-color-gray-6);
  }

  .capo-widget-highlight,
  .capo-widget-input {
    grid-area: 1 / 1 / 2 / 2;
    width: 100%;
    margin: 0 !important;
    padding: 0.75rem !important;
    font-family: var(--sl-font-mono, monospace) !important;
    font-size: 0.875rem !important;
    line-height: 1.4 !important;
    tab-size: 2;
    white-space: pre !important;
    word-break: normal !important;
    overflow-wrap: normal !important;
    box-sizing: border-box;
  }

  .capo-widget-highlight {
    pointer-events: none;
    border: 1px solid transparent;
    color: var(--sl-color-gray-2);
    overflow: hidden;
  }

  .capo-widget-input {
    min-height: 150px;
    max-height: 400px;
    background: transparent !important;
    color: transparent !important;
    caret-color: var(--sl-color-white, #ffffff);
    border: 1px solid transparent;
    resize: none;
    overflow: auto;
  }

  :root[data-theme='light'] .capo-widget-input {
    caret-color: var(--sl-color-gray-1, #000000);
  }

  .capo-widget-input:focus {
    outline: none;
  }

  .capo-widget-code-container:focus-within {
    border-color: var(--sl-color-text-accent);
  }

  /* Syntax Highlighting Colors matching VirtualConsole */
  :global(.capo-widget-code .tag) {
    color: #ff79c6;
    font-weight: bold;
  }
  :global(.capo-widget-code .attr) {
    color: #50fa7b;
  }
  :global(.capo-widget-code .val) {
    color: #f1fa8c;
  }

  :root[data-theme='light'] :global(.capo-widget-code .tag) {
    color: #881280;
  }
  :root[data-theme='light'] :global(.capo-widget-code .attr) {
    color: #994500;
  }
  :root[data-theme='light'] :global(.capo-widget-code .val) {
    color: #1a1aa6;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-self: center;
  }

  button {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    border: 1px solid transparent;
    border-radius: 999rem;
    margin: 0 !important;
    padding: 1rem 1.5rem;
    background-color: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font-size: var(--sl-text-base);
    font-weight: bold;
    transition: all 0.2s ease;
  }

  button:hover {
    opacity: 0.9;
  }

  #share {
    background-color: transparent;
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }

  #share:hover {
    background-color: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    opacity: 1;
  }

  #share.success {
    background-color: #10b981 !important;
    color: #ffffff !important;
    border-color: #10b981 !important;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  button svg {
    display: inline !important;
    vertical-align: middle;
    margin-left: 0.5rem;
  }

  input {
    width: 100%;
  }

  input:invalid {
    border-color: #9e0142;
  }
</style>

<p>To see capo.js in action, enter HTML or a URL in the form field below and click <strong>Run</strong>.</p>

<div id="capo-client">
  <form id="input">
    <Tabs>
      <TabItem label="HTML">
        <div class="capo-widget-code-container">
          <pre class="capo-widget-highlight" aria-hidden="true"><code class="capo-widget-code"></code></pre>
          <textarea id="markup" class="capo-widget-input" placeholder="Enter HTML" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off">&lt;title&gt;test&lt;/title&gt;
&lt;meta charset="utf-8"&gt;
&lt;meta name="description" content="Try capo.js"&gt;
&lt;style&gt;&lt;/style&gt;
&lt;meta http-equiv="origin-trial" content="AuNyVoVDAnYrBa2cL89WmgDSi1Os1UAt4SmcY1vXSJKDlIlBNfD4SEpIfg3LNDexEWv6N2kHnJ17MT4cVmRhQgIAAABueyJvcmlnaW4iOiJodHRwczovL3J2aXNjb21pLmdpdGh1Yi5pbzo0NDMiLCJmZWF0dXJlIjoiQmFja0ZvcndhcmRDYWNoZU5vdFJlc3RvcmVkUmVhc29ucyIsImV4cGlyeSI6MTY5MTUzOTE5OX0="&gt;
&lt;script&gt;&lt;/script&gt;</textarea>
        </div>
      </TabItem>
      <TabItem label="URL">
        <input id="url" type="url" value="https://www.example.com/" placeholder="https://www.example.com/" />
      </TabItem>
    </Tabs>
    <div class="actions">
      <button type="submit">Run <Icon name="rocket" color="inherit" size="1.5rem" /></button>
      <button type="button" id="share">Save Gist <Icon name="external" color="inherit" size="1.5rem" /></button>
    </div>
  </form>

  <VirtualConsole />
</div>
