{
  "name": "@rviscomi/capo.js",
  "version": "2.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Get your ﹤𝚑𝚎𝚊𝚍﹥ in order",
  "author": "Rick Viscomi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rviscomi/capo.js.git"
  },
  "bugs": {
    "url": "https://github.com/rviscomi/capo.js/issues"
  },
  "homepage": "https://rviscomi.github.io/capo.js/",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "src/index.js",
  "types": "./dist/types/index.d.ts",
  "alias": {
    "@rviscomi/capo.js": "./src/index.js",
    "@rviscomi/capo.js/adapters/browser": "./src/adapters/browser.js",
    "@rviscomi/capo.js/lib/io": "./src/lib/io.js",
    "@rviscomi/capo.js/lib/options": "./src/lib/options.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/types/adapters/index.d.ts",
      "import": "./src/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./adapters/browser": {
      "types": "./dist/types/adapters/browser.d.ts",
      "import": "./src/adapters/browser.js",
      "require": "./dist/adapters/browser.cjs"
    },
    "./rules": {
      "types": "./dist/types/lib/rules.d.ts",
      "import": "./src/lib/rules.js",
      "require": "./dist/lib/rules.cjs"
    },
    "./validation": {
      "types": "./dist/types/lib/validation.d.ts",
      "import": "./src/lib/validation.js",
      "require": "./dist/lib/validation.cjs"
    },
    "./lib/io": {
      "types": "./dist/types/lib/io.d.ts",
      "import": "./src/lib/io.js",
      "require": "./dist/lib/io.cjs"
    },
    "./lib/options": {
      "types": "./dist/types/lib/options.d.ts",
      "import": "./src/lib/options.js",
      "require": "./dist/lib/options.cjs"
    },
    "./adapters/test-suite": {
      "types": "./dist/types/adapters/test-suite.d.ts",
      "import": "./src/adapters/test-suite.js",
      "require": "./dist/adapters/test-suite.cjs"
    }
  },
  "directories": {
    "doc": "docs"
  },
  "targets": {
    "chrome": {
      "source": "src/extension/capo.js",
      "distDir": "dist/chrome",
      "sourceMap": false
    },
    "chrome-options": {
      "source": "src/extension/options.js",
      "distDir": "dist/chrome/options",
      "sourceMap": false
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:ext": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "build:types": "tsc -p tsconfig.json",
    "watch": "parcel watch",
    "build": "npm run build:cjs && npm run build:types && parcel build && node scripts/build-extension.js",
    "package:source": "zip -r -q dist/source.zip . -x \"node_modules/*\" \"dist/*\" \".git/*\" \".parcel-cache/*\" \"docs/node_modules/*\" \"docs/.astro/*\" \"docs/dist/*\" \".github/*\" \"*/.DS_Store\" \".DS_Store\"",
    "build:cjs": "esbuild src/index.js src/analyzer.js src/adapters/adapter.js src/adapters/index.js src/adapters/browser.js src/lib/rules.js src/lib/validation.js src/lib/io.js src/lib/options.js src/lib/colors.js src/adapters/test-suite.js --bundle --platform=node --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js",
    "test:rules": "node --test tests/lib/rules.test.js",
    "test:validation": "node --test tests/lib/validation.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "devDependencies": {
    "@parcel/cache": "^2.16.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "chrome-types": "^0.1.436",
    "dedent": "^1.7.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "parcel": "^2.16.4",
    "typescript": "^7.0.2"
  }
}
